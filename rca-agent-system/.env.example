GOOGLE_API_KEY=your-gemini-api-key-here
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Bind address. Loopback by default: the service is unauthenticated and its
# endpoints spend Gemini quota / can start evaluation subprocesses. Use
# 0.0.0.0 only behind an authenticating reverse proxy.
ADK_HOST=127.0.0.1
ADK_PORT=8000
ADK_CORS_ORIGINS=http://localhost:3000
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=incident_memory
SESSION_DB_URL=sqlite+aiosqlite:///./data/sessions.db
GEMINI_MODEL=gemini-2.5-flash

# Phase 9: enables `POST /demo/reset-memory` which wipes ChromaDB and
# reseeds it from `seed/incidents/`. Destructive. Set to "1" only on
# demo machines; leave unset (default-deny) elsewhere.
ALLOW_DEMO_RESET=0

# Tier 0: reflection/memory calibration (How-To-Improve/TIER0_PLAN.md SS4).
# All five have working defaults baked into rca_system/settings.py --
# uncomment only to override.
# MAX_NEGATIVE_DELTA_FRACTION=0.4
# SCORE_PRIOR_STRENGTH=2.0
# DELTA_TO_PSEUDOCOUNT_SCALE=0.2
# EXPLORATION_BONUS_WEIGHT=0.1
# REFLECTION_ENSEMBLE_SIZE=3
