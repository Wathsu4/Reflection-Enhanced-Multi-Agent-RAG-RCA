CLASSIFIER_MODEL_PATH=./models/modernbert-log-severity-v1
CLASSIFIER_DEVICE=auto           # auto | cpu | cuda | mps
# Bind address used by scripts/run-all.sh. Loopback by default; the service
# is unauthenticated, so expose it only behind a reverse proxy.
CLASSIFIER_HOST=127.0.0.1
CLASSIFIER_PORT=8001
CLASSIFIER_CORS_ORIGINS=http://localhost:3000
CLASSIFIER_MAX_CHUNK_BYTES=500000
